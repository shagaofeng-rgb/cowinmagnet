# Existing application configuration is omitted. Keep real credentials only in Vercel/environment secrets.
DATABASE_URL=
CRON_SECRET=
NEWS_AUTOMATION_PRODUCTION_ENABLED=false
# NEWS_AUTO_PUBLISH takes precedence when it is set. Keep false until source and product facts are ready.
NEWS_AUTO_PUBLISH=false
# Legacy variable retained only for an existing deployment's compatibility; the current News worker ignores it.
NEWS_AUTOPUBLISH_ENABLED=false
NEWS_SITE_ID=cowinmagnet-production
NEWS_TIMEZONE=Asia/Shanghai
NEWS_LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=
NEWS_DISCOVERY_MAX_SOURCES=8
# Search Console service-account credentials. Keep real values only in Vercel.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.cowinmagnet.com/
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=https://www.cowinmagnet.com/sitemap.xml
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GSC_HEALTH_TOKEN=

# Meta Pixel + Conversions API. Keep META_CAPI_ACCESS_TOKEN in Vercel only; never expose it to the browser or commit it.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ENABLED=true
META_CAPI_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_GRAPH_VERSION=v26.0
# Use only while validating through Meta Events Manager, then remove it.
META_CAPI_TEST_EVENT_CODE=
