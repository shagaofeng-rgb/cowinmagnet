{
  "name": "cowinmagnet-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/build-sitemap-static-dates.mjs && node scripts/build-generated-news-index.mjs",
    "dev": "next dev",
    "news:daily": "node scripts/run-news-system.mjs job",
    "news:fetch": "node scripts/run-news-system.mjs fetch",
    "news:generate": "node scripts/run-news-system.mjs generate --mode=draft",
    "news:publish": "node scripts/run-news-system.mjs publish --mode=auto",
    "news:job": "node scripts/run-news-system.mjs job",
    "news:repair-images": "node scripts/repair-news-source-images.mjs --only-overrides",
    "blog:daily": "node scripts/run-blog-automation.mjs",
    "monitor": "node scripts/monitor/run-monitor.mjs",
    "monitor:no-email": "node scripts/monitor/run-monitor.mjs --no-email",
    "visual:qa": "node scripts/visual-qa-capture.mjs",
    "sitemap:generate": "node scripts/run-sitemap.mjs",
    "sitemap:audit": "node scripts/audit-sitemap-http.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "node scripts/final-audit-smoke.mjs",
    "build": "next build --webpack && node -e \"require('fs').closeSync(require('fs').openSync('.next/lock','w'))\"",
    "start": "next start"
  },
  "dependencies": {
    "google-news-url-decoder": "1.2.2",
    "lucide-react": "0.468.0",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.6",
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "typescript": "5.7.2"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.0",
    "@img/sharp-linux-x64": "^0.35.1"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
